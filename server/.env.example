# Server
PORT=4000
CORS_ORIGIN=*

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/black_excellence_trivia

# AI question generation
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector store (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=black-excellence-trivia-questions
DEDUP_SIMILARITY_THRESHOLD=0.85

# Never commit a filled-in copy of this file. Copy to .env and fill in real values locally only.
